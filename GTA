<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>LOS SOLARIS — 3D Открытый мир (GTA Sandbox)</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Oswald:wght@600;700&display=swap');

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: #142230;
      color: #f2f6fb;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      user-select: none;
      touch-action: none;
    }

    #canvas-container {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
    }

    /* Crosshair */
    #crosshair {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      z-index: 10;
      pointer-events: none;
      width: 24px;
      height: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.08s ease;
    }

    #crosshair .dot {
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: #ffffff;
      box-shadow: 0 0 4px rgba(0, 0, 0, 0.9);
    }

    #crosshair .ring {
      position: absolute;
      inset: 2px;
      border: 1.5px solid rgba(255, 255, 255, 0.72);
      border-radius: 50%;
      box-shadow: 0 0 4px rgba(0, 0, 0, 0.6);
      transition: all 0.08s ease;
    }

    #crosshair.hit .ring {
      border-color: #ff3b3b;
      transform: scale(1.35);
    }

    #crosshair.aim .ring {
      inset: 5px;
      border-color: #ffe066;
    }

    /* Top-Right GTA V Style HUD */
    #top-right-hud {
      position: fixed;
      top: 16px;
      right: 18px;
      z-index: 10;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 6px;
      pointer-events: none;
      text-shadow: 0 2px 6px rgba(0, 0, 0, 0.85);
    }

    #wanted-stars {
      font-size: 20px;
      letter-spacing: 3px;
      color: rgba(255, 255, 255, 0.22);
    }

    #wanted-stars .lit {
      color: #ffffff;
      text-shadow: 0 0 10px rgba(70, 170, 255, 0.95);
    }

    #cash-display {
      font-family: 'Oswald', sans-serif;
      font-size: 26px;
      font-weight: 700;
      color: #56e37f;
      letter-spacing: 0.03em;
      line-height: 1;
    }

    #weapon-hud {
      background: rgba(10, 15, 24, 0.72);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 8px;
      padding: 6px 12px;
      display: flex;
      align-items: center;
      gap: 10px;
      pointer-events: auto;
    }

    #weapon-name {
      font-family: 'Oswald', sans-serif;
      font-size: 13px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #f8fafc;
    }

    #ammo-count {
      font-family: 'Oswald', sans-serif;
      font-size: 15px;
      color: #ffd166;
    }

    #top-controls {
      display: flex;
      gap: 6px;
      pointer-events: auto;
    }

    .mini-btn {
      background: rgba(10, 15, 24, 0.74);
      border: 1px solid rgba(255, 255, 255, 0.16);
      color: #e2ecf8;
      font-size: 11px;
      font-weight: 600;
      padding: 5px 10px;
      border-radius: 6px;
      cursor: pointer;
      backdrop-filter: blur(8px);
      transition: all 0.15s;
    }

    .mini-btn:hover, .mini-btn.active {
      background: rgba(255, 209, 102, 0.25);
      border-color: rgba(255, 209, 102, 0.7);
      color: #fff3c4;
    }

    /* Bottom-Left GTA V Radar Minimap + Health/Armor */
    #minimap-box {
      position: fixed;
      bottom: 16px;
      left: 16px;
      z-index: 10;
      width: 176px;
      background: rgba(8, 12, 18, 0.85);
      border: 2px solid rgba(255, 255, 255, 0.22);
      border-radius: 6px;
      padding: 4px;
      box-shadow: 0 8px 28px rgba(0, 0, 0, 0.65);
      pointer-events: none;
    }

    #minimap-canvas {
      display: block;
      width: 164px;
      height: 114px;
      border-radius: 3px;
      background: #142838;
    }

    .bars-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4px;
      margin-top: 4px;
    }

    .stat-track {
      height: 7px;
      background: rgba(255, 255, 255, 0.14);
      border-radius: 2px;
      overflow: hidden;
    }

    #hp-bar {
      height: 100%;
      width: 100%;
      background: #4cd964;
      transition: width 0.2s;
    }

    #armor-bar {
      height: 100%;
      width: 100%;
      background: #38bdf8;
      transition: width 0.2s;
    }

    /* Bottom-Right Zone Name & Context Prompt */
    #bottom-right-hud {
      position: fixed;
      bottom: 18px;
      right: 18px;
      z-index: 10;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 6px;
      pointer-events: none;
      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.9);
    }

    #zone-name {
      font-family: 'Oswald', sans-serif;
      font-size: 20px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #ffffff;
    }

    #speed-badge {
      font-family: 'Oswald', sans-serif;
      font-size: 16px;
      color: #ffd166;
      display: none;
    }

    #action-prompt {
      position: fixed;
      top: 18px;
      left: 18px;
      z-index: 11;
      background: rgba(10, 14, 22, 0.82);
      border-left: 3px solid #ffd166;
      padding: 8px 13px;
      border-radius: 4px;
      font-size: 12px;
      font-weight: 500;
      color: #eef4fa;
      max-width: 280px;
      opacity: 0;
      transition: opacity 0.2s ease;
      pointer-events: none;
    }

    #action-prompt.visible {
      opacity: 1;
    }

    #damage-flash {
      position: fixed;
      inset: 0;
      z-index: 6;
      pointer-events: none;
      background: radial-gradient(ellipse at center, rgba(255,0,0,0) 45%, rgba(220,20,30,0.55) 100%);
      opacity: 0;
      transition: opacity 0.1s;
    }

    /* Start / Wasted Overlay */
    #overlay {
      position: fixed;
      inset: 0;
      z-index: 25;
      display: flex;
      align-items: center;
      justify-content: center;
      background: radial-gradient(ellipse at center, rgba(12, 18, 28, 0.52) 0%, rgba(5, 8, 14, 0.88) 100%);
      backdrop-filter: blur(5px);
      padding: 20px;
      transition: opacity 0.28s ease;
    }

    #overlay.hidden {
      opacity: 0;
      pointer-events: none;
    }

    .card {
      max-width: 470px;
      width: 100%;
      background: rgba(10, 15, 24, 0.9);
      border: 1px solid rgba(255, 209, 102, 0.35);
      border-radius: 14px;
      padding: 26px 24px;
      text-align: center;
      box-shadow: 0 24px 64px rgba(0, 0, 0, 0.78);
    }

    .logo {
      font-family: 'Oswald', sans-serif;
      font-size: 36px;
      font-weight: 700;
      letter-spacing: 0.1em;
      color: #ffd166;
      text-shadow: 0 4px 18px rgba(255, 190, 60, 0.35);
      margin-bottom: 6px;
    }

    .desc {
      font-size: 13px;
      color: rgba(212, 224, 240, 0.84);
      line-height: 1.5;
      margin-bottom: 16px;
    }

    .keys-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 7px;
      text-align: left;
      margin-bottom: 18px;
      font-size: 11.5px;
      color: #d6e4f2;
    }

    .key-row {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 6px;
      padding: 6px 9px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .k {
      font-weight: 700;
      color: #ffd166;
    }

    #btn-start {
      width: 100%;
      padding: 13px;
      border: none;
      border-radius: 10px;
      background: linear-gradient(135deg, #ffd166, #f59e0b);
      color: #0b0f17;
      font-family: 'Oswald', sans-serif;
      font-size: 17px;
      font-weight: 700;
      letter-spacing: 0.12em;
      cursor: pointer;
      box-shadow: 0 6px 24px rgba(245, 158, 11, 0.42);
      transition: transform 0.14s ease;
    }

    #btn-start:hover {
      transform: translateY(-2px);
    }

    @media (max-width: 640px) {
      #minimap-box { width: 138px; bottom: 10px; left: 10px; }
      #minimap-canvas { width: 126px; height: 90px; }
      #cash-display { font-size: 20px; }
      #zone-name { font-size: 16px; }
      .keys-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <div id="canvas-container"></div>
  <div id="damage-flash"></div>

  <div id="crosshair">
    <div class="ring"></div>
    <div class="dot"></div>
  </div>

  <div id="action-prompt">Нажмите <b>E</b>, чтобы сесть в машину</div>

  <div id="top-right-hud">
    <div id="wanted-stars">★★★★★</div>
    <div id="cash-display">$2 500</div>
    <div id="weapon-hud">
      <span id="weapon-name">M4 КАРАБИН</span>
      <span id="ammo-count">∞</span>
    </div>
    <div id="top-controls">
      <button type="button" class="mini-btn active" data-wpn="0">1 Пистолет</button>
      <button type="button" class="mini-btn" data-wpn="1">2 Автомат</button>
      <button type="button" class="mini-btn" data-wpn="2">3 Дробовик</button>
      <button type="button" class="mini-btn" id="btn-audio">Звук: Выкл</button>
    </div>
  </div>

  <div id="minimap-box">
    <canvas id="minimap-canvas" width="164" height="114"></canvas>
    <div class="bars-row">
      <div class="stat-track"><div id="hp-bar"></div></div>
      <div class="stat-track"><div id="armor-bar"></div></div>
    </div>
  </div>

  <div id="bottom-right-hud">
    <div id="speed-badge">0 КМ/Ч</div>
    <div id="zone-name">ДАУНТАУН СОЛАРИС</div>
  </div>

  <div id="overlay">
    <div class="card">
      <div class="logo" id="ov-title">LOS SOLARIS</div>
      <div class="desc" id="ov-desc">
        Открытый 3D-мир в духе GTA V: солнечный мегаполис, песчаный пляж с океаном, горы Вайнвуд и промзона. Ходи пешком, стреляй, взрывай бочки, угоняй спорткары и уходи от полиции!
      </div>
      <div class="keys-grid">
        <div class="key-row"><span>Ходьба / Езда</span><span class="k">W A S D</span></div>
        <div class="key-row"><span>Стрельба / Прицел</span><span class="k">ЛКМ / ПКМ</span></div>
        <div class="key-row"><span>Сесть / Выйти из авто</span><span class="k">E</span></div>
        <div class="key-row"><span>Бег / Прыжок</span><span class="k">Shift / Пробел</span></div>
        <div class="key-row"><span>Смена оружия</span><span class="k">1 · 2 · 3</span></div>
        <div class="key-row"><span>Обзор камерой</span><span class="k">Мышь</span></div>
      </div>
      <button type="button" id="btn-start">ИГРАТЬ</button>
    </div>
  </div>

  <script>
    (function () {
      'use strict';

      if (typeof THREE === 'undefined') {
        document.body.innerHTML = '<div style="padding:32px;color:#fff;font-family:sans-serif;">Не удалось загрузить Three.js.</div>';
        return;
      }

      // ============================================================
      // 1. OPEN-WORLD TERRAIN HEIGHTFIELD & BIOME MAP (520x520m)
      // ============================================================
      const WORLD_SIZE = 520;
      const HALF_WORLD = WORLD_SIZE / 2;
      const WATER_LEVEL = -1.6;

      // Smooth deterministic California-style elevation:
      // Center (-85..85, -85..85): flat Downtown city plateau (y = 0)
      // South (z > 95): slopes gently down to golden beach & Pacific Ocean
      // North & West (z < -95 or x < -95): scenic Vinewood hills & mountain ridge (up to 34m!)
      // East (x > 95): industrial port & rolling foothills
      function smoothstep(edge0, edge1, x) {
        const t = Math.max(0, Math.min(1, (x - edge0) / (edge1 - edge0)));
        return t * t * (3 - 2 * t);
      }

      function getTerrainHeight(x, z) {
        // City flat plateau mask (0 inside downtown, 1 outside)
        const cityMaskX = smoothstep(78, 128, Math.abs(x));
        const cityMaskZ = smoothstep(78, 128, Math.abs(z));
        const outsideCity = Math.max(cityMaskX, cityMaskZ);

        // Rolling hills in North & West
        const northHill = smoothstep(-75, -185, z);
        const westHill  = smoothstep(-85, -200, x);
        const hillFactor = Math.min(1, northHill * 1.15 + westHill * 0.75);

        const undulation =
          Math.sin(x * 0.024) * Math.cos(z * 0.022) * 14.0 +
          Math.sin(x * 0.055 + 1.4) * Math.sin(z * 0.048) * 6.5 +
          Math.cos((x + z) * 0.015) * 9.0;

        let h = hillFactor * (16.0 + Math.max(0, undulation));

        // Gentle foothills in East/Northeast
        const eastFoothill = smoothstep(105, 220, x) * smoothstep(85, -60, z);
        h += eastFoothill * (7.5 + Math.sin(x * 0.04) * Math.cos(z * 0.045) * 5.0);

        // Beach & Ocean slope in the South (z > 92)
        const beachSlope = smoothstep(92, 195, z);
        h = h * (1.0 - beachSlope) - beachSlope * 6.8;

        // Keep city center perfectly flat at y = 0
        if (z < 92) {
          h *= outsideCity;
        }
        return h;
      }

      function getZoneName(x, z) {
        if (z > 105) return 'ПЛЯЖ СОЛАРИС';
        if (z < -95) return 'ХОЛМЫ ВАЙНВУД';
        if (x > 95)  return 'ПРОМЗОНА И ПОРТ';
        if (x < -95) return 'ЗАПАДНЫЙ КАЛЬОН';
        return 'ДАУНТАУН СОЛАРИС';
      }

      // ============================================================
      // 2. PROCEDURAL PBR TEXTURES (BUILDINGS, ASPHALT, SIGN)
      // ============================================================
      function createTowerTexture(wallHex, glassHex, floors) {
        const c = document.createElement('canvas');
        c.width = 512;
        c.height = 1024;
        const ctx = c.getContext('2d');
        ctx.fillStyle = wallHex;
        ctx.fillRect(0, 0, 512, 1024);

        const cols = 8;
        const cw = 512 / cols;
        const rh = 1024 / floors;
        for (let r = 0; r < floors; r++) {
          for (let col = 0; col < cols; col++) {
            const shade = ((r * 19 + col * 37) % 10) / 10;
            ctx.fillStyle = glassHex;
            ctx.globalAlpha = 0.65 + shade * 0.35;
            ctx.fillRect(col * cw + 6, r * rh + 6, cw - 12, rh - 14);
            // Sunlit window reflection diagonal
            ctx.fillStyle = 'rgba(255,245,225,0.22)';
            ctx.fillRect(col * cw + 6, r * rh + 6, (cw - 12) * 0.4, (rh - 14) * 0.45);
          }
        }
        ctx.globalAlpha = 1;
        const tex = new THREE.CanvasTexture(c);
        tex.encoding = THREE.sRGBEncoding;
        tex.anisotropy = 8;
        return tex;
      }

      function createRoadTexture() {
        const c = document.createElement('canvas');
        c.width = 512;
        c.height = 512;
        const ctx = c.getContext('2d');
        ctx.fillStyle = '#262b33';
        ctx.fillRect(0, 0, 512, 512);

        // Asphalt noise
        for (let i = 0; i < 6000; i++) {
          const x = (i * 97) % 512;
          const y = (i * 193) % 512;
          ctx.fillStyle = i % 2 === 0 ? 'rgba(255,255,255,0.04)' : 'rgba(0,0,0,0.08)';
          ctx.fillRect(x, y, 2, 2);
        }
        // Double yellow center line
        ctx.fillStyle = '#e8b931';
        ctx.fillRect(247, 0, 6, 512);
        ctx.fillRect(259, 0, 6, 512);

        // White outer curbs
        ctx.fillStyle = '#cbd5e1';
        ctx.fillRect(14, 0, 6, 512);
        ctx.fillRect(492, 0, 6, 512);

        const tex = new THREE.CanvasTexture(c);
        tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
        tex.encoding = THREE.sRGBEncoding;
        tex.anisotropy = 8;
        return tex;
      }

      // ============================================================
      // 3. SCENE, RENDERER & GOLDEN CALIFORNIA SUNLIGHT
      // ============================================================
      const container = document.getElementById('canvas-container');
      const scene = new THREE.Scene();
      scene.fog = new THREE.FogExp2(0x9fc4dc, 0.0024);

      const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.25, 780);
      const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: 'high-performance' });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.08;
      renderer.outputEncoding = THREE.sRGBEncoding;
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = THREE.PCFSoftShadowMap;
      container.appendChild(renderer.domElement);

      // Golden Hour California Sky Dome
      const skyMat = new THREE.ShaderMaterial({
        side: THREE.BackSide,
        depthWrite: false,
        fog: false,
        vertexShader: `
          varying vec3 vDir;
          void main() {
            vDir = normalize(position);
            gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
          }
        `,
        fragmentShader: `
          varying vec3 vDir;
          void main() {
            vec3 d = normalize(vDir);
            float h = clamp(d.y, 0.0, 1.0);
            vec3 zenith = vec3(0.14, 0.40, 0.74);
            vec3 midSky = vec3(0.45, 0.72, 0.90);
            vec3 horizon = vec3(0.95, 0.80, 0.62);
            vec3 col = mix(horizon, midSky, smoothstep(0.0, 0.24, h));
            col = mix(col, zenith, smoothstep(0.20, 0.78, h));

            vec3 sunDir = normalize(vec3(0.62, 0.38, 0.68));
            float sunDot = max(dot(d, sunDir), 0.0);
            col += vec3(1.0, 0.92, 0.75) * pow(sunDot, 220.0) * 1.8;
            col += vec3(1.0, 0.78, 0.45) * pow(sunDot, 12.0) * 0.42;

            gl_FragColor = vec4(col, 1.0);
          }
        `
      });
      scene.add(new THREE.Mesh(new THREE.SphereGeometry(620, 32, 20), skyMat));

      const hemiLight = new THREE.HemisphereLight(0x9bd0ff, 0x5c5342, 0.9);
      scene.add(hemiLight);

      const sunLight = new THREE.DirectionalLight(0xfff0d4, 1.55);
      sunLight.position.set(110, 95, 120);
      sunLight.castShadow = true;
      sunLight.shadow.mapSize.width = 2048;
      sunLight.shadow.mapSize.height = 2048;
      sunLight.shadow.camera.near = 20;
      sunLight.shadow.camera.far = 360;
      const dShadow = 115;
      sunLight.shadow.camera.left = -dShadow;
      sunLight.shadow.camera.right = dShadow;
      sunLight.shadow.camera.top = dShadow;
      sunLight.shadow.camera.bottom = -dShadow;
      sunLight.shadow.bias = -0.0005;
      scene.add(sunLight);

      // ============================================================
      // 4. TERRAIN MESH (VERTEX-COLORED BIOMES) + ANIMATED PACIFIC OCEAN
      // ============================================================
      const terrainGeo = new THREE.PlaneGeometry(WORLD_SIZE, WORLD_SIZE, 140, 140);
      terrainGeo.rotateX(-Math.PI / 2);
      const tPos = terrainGeo.attributes.position;
      const tColors = new Float32Array(tPos.count * 3);
      const colTmp = new THREE.Color();

      for (let i = 0; i < tPos.count; i++) {
        const x = tPos.getX(i);
        const z = tPos.getZ(i);
        const y = getTerrainHeight(x, z);
        tPos.setY(i, y);

        // Biome vertex coloring: concrete city, golden beach sand, lush hills, rocky peaks
        if (z > 94 && y < 1.8) {
          colTmp.setHex(y < WATER_LEVEL + 0.5 ? 0xb59b6b : 0xe3cb96); // Wet & dry beach sand
        } else if (Math.abs(x) < 90 && Math.abs(z) < 90) {
          colTmp.setHex(0x525860); // Urban concrete ground
        } else if (y > 18) {
          colTmp.setHex(0x6e685d); // Mountain granite
        } else if (y > 6) {
          colTmp.setHex(0x5b7546); // California hillside chaparral
        } else {
          colTmp.setHex(0x6a834d); // Grassy foothills
        }
        tColors[i * 3] = colTmp.r;
        tColors[i * 3 + 1] = colTmp.g;
        tColors[i * 3 + 2] = colTmp.b;
      }
      terrainGeo.setAttribute('color', new THREE.BufferAttribute(tColors, 3));
      terrainGeo.computeVertexNormals();

      const terrainMesh = new THREE.Mesh(
        terrainGeo,
        new THREE.MeshStandardMaterial({ vertexColors: true, roughness: 0.92, metalness: 0.02 })
      );
      terrainMesh.receiveShadow = true;
      scene.add(terrainMesh);

      // Shimmering Pacific Ocean along the Southern Coast
      const oceanUniforms = { uTime: { value: 0 } };
      const oceanMat = new THREE.ShaderMaterial({
        uniforms: oceanUniforms,
        transparent: true,
        vertexShader: `
          uniform float uTime;
          varying vec3 vWorldPos;
          void main() {
            vec3 p = position;
            p.y += sin(p.x * 0.08 + uTime * 1.6) * 0.28 + cos(p.z * 0.11 + uTime * 1.3) * 0.22;
            vec4 wp = modelMatrix * vec4(p, 1.0);
            vWorldPos = wp.xyz;
            gl_Position = projectionMatrix * viewMatrix * wp;
          }
        `,
        fragmentShader: `
          uniform float uTime;
          varying vec3 vWorldPos;
          void main() {
            float wave = sin(vWorldPos.x * 0.18 + uTime * 2.2) * cos(vWorldPos.z * 0.22 - uTime * 1.8);
            vec3 shallow = vec3(0.08, 0.56, 0.65);
            vec3 deep    = vec3(0.03, 0.24, 0.42);
