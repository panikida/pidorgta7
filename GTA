      let audioCtx = null;

      function ensureAudio() {
        if (!audioCtx) {
          const AC = window.AudioContext || window.webkitAudioContext;
          if (AC) audioCtx = new AC();
        }
        if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
      }

      function playGunshot(wpnIdx) {
        if (!audioCtx || !state.audio) return;
        const now = audioCtx.currentTime;
        const dur = wpnIdx === 2 ? 0.22 : (wpnIdx === 1 ? 0.09 : 0.12);
        const buf = audioCtx.createBuffer(1, Math.floor(audioCtx.sampleRate * dur), audioCtx.sampleRate);
        const data = buf.getChannelData(0);
        for (let i = 0; i < data.length; i++) {
          data[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / data.length, 1.8);
        }
        const src = audioCtx.createBufferSource();
        src.buffer = buf;
        const flt = audioCtx.createBiquadFilter();
        flt.type = 'lowpass';
        flt.frequency.value = wpnIdx === 2 ? 750 : 1650;
        const g = audioCtx.createGain();
        g.gain.setValueAtTime(wpnIdx === 2 ? 0.5 : 0.3, now);
        g.gain.exponentialRampToValueAtTime(0.001, now + dur);
        src.connect(flt); flt.connect(g); g.connect(audioCtx.destination);
        src.start(now);
      }

      function playExplosionSfx() {
        if (!audioCtx || !state.audio) return;
        const now = audioCtx.currentTime;
        const dur = 0.65;
        const buf = audioCtx.createBuffer(1, Math.floor(audioCtx.sampleRate * dur), audioCtx.sampleRate);
        const data = buf.getChannelData(0);
        for (let i = 0; i < data.length; i++) {
          data[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / data.length, 1.4);
        }
        const src = audioCtx.createBufferSource();
        src.buffer = buf;
        const flt = audioCtx.createBiquadFilter();
        flt.type = 'lowpass';
        flt.frequency.setValueAtTime(320, now);
        flt.frequency.exponentialRampToValueAtTime(60, now + dur);
        const g = audioCtx.createGain();
        g.gain.setValueAtTime(0.6, now);
        g.gain.exponentialRampToValueAtTime(0.001, now + dur);
        src.connect(flt); flt.connect(g); g.connect(audioCtx.destination);
        src.start(now);
      }

