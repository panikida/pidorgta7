      const elOverlay = document.getElementById('overlay');
      const elOvTitle = document.getElementById('ov-title');
      const elOvDesc = document.getElementById('ov-desc');
      const btnStart = document.getElementById('btn-start');
      const elCrosshair = document.getElementById('crosshair');
      const elWanted = document.getElementById('wanted-stars');
      const elCash = document.getElementById('cash-display');
      const elWeaponName = document.getElementById('weapon-name');
      const elHp = document.getElementById('hp-bar');
      const elArmor = document.getElementById('armor-bar');
      const elZone = document.getElementById('zone-name');
      const elSpeed = document.getElementById('speed-badge');
      const elPrompt = document.getElementById('action-prompt');
      const elDmgFlash = document.getElementById('damage-flash');
      const mapCanvas = document.getElementById('minimap-canvas');
      const mapCtx = mapCanvas.getContext('2d');

      function updateHudStats() {
        let starsHtml = '';
        for (let i = 0; i < 5; i++) {
          starsHtml += i < state.wanted ? '<span class="lit">★</span>' : '★';
        }
        elWanted.innerHTML = starsHtml;
        elCash.textContent = `$${state.cash.toLocaleString('ru-RU')}`;
        elHp.style.width = `${Math.max(0, state.hp)}%`;
        elArmor.style.width = `${Math.max(0, state.armor)}%`;
      }

      function selectWeapon(idx) {
        state.weaponIdx = idx;
        elWeaponName.textContent = WEAPONS[idx].name;
        document.querySelectorAll('[data-wpn]').forEach(b => {
          b.classList.toggle('active', parseInt(b.dataset.wpn, 10) === idx);
        });
      }
      selectWeapon(1);
      updateHudStats();

      function raiseWanted() {
        if (state.wanted < 5) {
          state.wanted++;
          updateHudStats();
          // Spawn a police reinforcement nearby
          const angle = Math.random() * Math.PI * 2;
          const px = Math.max(-210, Math.min(210, state.x + Math.cos(angle) * 48));
          const pz = Math.max(-210, Math.min(110, state.z + Math.sin(angle) * 48));
          spawnEnemy(px, pz, true);
        }
      }

      function damageEnemy(en, dmg) {
        if (en.hp <= 0) return;
        en.hp -= dmg;
        en.aggro = true;
        elCrosshair.classList.add('hit');
        setTimeout(() => elCrosshair.classList.remove('hit'), 110);

        if (en.hp <= 0) {
          en.mesh.rotation.x = -Math.PI / 2;
          en.mesh.position.y = getTerrainHeight(en.x, en.z) + 0.25;
          state.cash += en.isPolice ? 350 : 200;
          raiseWanted();
          updateHudStats();
          setTimeout(() => {
            scene.remove(en.mesh);
          }, 5000);
        }
      }

      const raycaster = new THREE.Raycaster();

      function fireWeapon() {
        const w = WEAPONS[state.weaponIdx];
        state.fireCd = w.rate;
        muzzleFlash.intensity = 5.5;
        state.shake = Math.max(state.shake, state.weaponIdx === 2 ? 0.14 : 0.045);
        playGunshot(state.weaponIdx);

        const muzzleWorld = new THREE.Vector3();
        muzzleFlash.getWorldPosition(muzzleWorld);

        // Collect shootable meshes
        const targetMeshes = [];
        enemies.forEach(en => { if (en.hp > 0) targetMeshes.push({ obj: en.mesh, type: 'enemy', ref: en }); });
        barrels.forEach(b => { if (b.alive) targetMeshes.push({ obj: b.mesh, type: 'barrel', ref: b }); });

        for (let p = 0; p < w.pellets; p++) {
          const sx = (Math.random() - 0.5) * w.spread;
          const sy = (Math.random() - 0.5) * w.spread;
          raycaster.setFromCamera(new THREE.Vector2(sx, sy), camera);
          raycaster.far = w.range;

          let hitPoint = raycaster.ray.origin.clone().addScaledVector(raycaster.ray.direction, w.range);
          let bestDist = w.range;
          let bestHit = null;

          for (let i = 0; i < targetMeshes.length; i++) {
            const hits = raycaster.intersectObject(targetMeshes[i].obj, true);
            if (hits.length > 0 && hits[0].distance < bestDist) {
              bestDist = hits[0].distance;
              hitPoint = hits[0].point;
              bestHit = targetMeshes[i];
            }
          }

          spawnTracer(muzzleWorld, hitPoint, 0xffe484);

          if (bestHit) {
            if (bestHit.type === 'enemy') {
              damageEnemy(bestHit.ref, w.dmg);
            } else if (bestHit.type === 'barrel') {
              bestHit.ref.hp -= w.dmg;
              if (bestHit.ref.hp <= 0 && bestHit.ref.alive) {
                bestHit.ref.alive = false;
                bestHit.ref.mesh.visible = false;
                spawnExplosion(bestHit.ref.x, bestHit.ref.y, bestHit.ref.z, 12);
                raiseWanted();
              }
            }
          }
        }
      }

      function toggleVehicle() {
        if (state.inCar) {
          // Step out next to car
          state.x = state.inCar.x + Math.cos(state.inCar.yaw) * 2.6;
          state.z = state.inCar.z - Math.sin(state.inCar.yaw) * 2.6;
          state.y = getTerrainHeight(state.x, state.z);
          state.inCar.speed = 0;
          state.inCar = null;
          playerGroup.visible = true;
          elSpeed.style.display = 'none';
          return;
        }
        // Find nearest car within 4.5m
        let best = null, bestD = 4.6;
        for (let i = 0; i < cars.length; i++) {
          const d = Math.hypot(cars[i].x - state.x, cars[i].z - state.z);
          if (d < bestD) { bestD = d; best = cars[i]; }
        }
        if (best) {
          state.inCar = best;
          playerGroup.visible = false;
          elSpeed.style.display = 'block';
        }
      }

      // UI & Input Listeners
      btnStart.addEventListener('click', () => {
        if (state.hp <= 0) {
          // Respawn after Wasted
          state.hp = 100;
          state.armor = 100;
          state.wanted = 0;
          state.x = 0; state.z = 18; state.y = 0;
          if (state.inCar) toggleVehicle();
          updateHudStats();
        }
        state.active = true;
        elOverlay.classList.add('hidden');
        try {
          if (renderer.domElement.requestPointerLock) renderer.domElement.requestPointerLock();
        } catch (e) {}
      });

      document.querySelectorAll('[data-wpn]').forEach(b => {
        b.addEventListener('click', (e) => {
          e.stopPropagation();
          selectWeapon(parseInt(b.dataset.wpn, 10));
        });
      });

      document.getElementById('btn-audio').addEventListener('click', (e) => {
        e.stopPropagation();
        ensureAudio();
        state.audio = !state.audio;
        e.target.textContent = state.audio ? 'Звук: Вкл' : 'Звук: Выкл';
        e.target.classList.toggle('active', state.audio);
      });

      document.addEventListener('pointerlockchange', () => {
        state.pointerLocked = document.pointerLockElement === renderer.domElement;
      });

      renderer.domElement.addEventListener('mousedown', (e) => {
        if (!state.active) return;
        if (e.button === 0) {
          state.firing = true;
          if (!state.pointerLocked) {
            state.draggingLook = true;
            state.lastMX = e.clientX;
            state.lastMY = e.clientY;
            try {
              if (renderer.domElement.requestPointerLock) renderer.domElement.requestPointerLock();
            } catch (err) {}
          }
        } else if (e.button === 2) {
          state.aiming = true;
          elCrosshair.classList.add('aim');
        }
      });

      window.addEventListener('mouseup', (e) => {
        if (e.button === 0) {
          state.firing = false;
          state.draggingLook = false;
        } else if (e.button === 2) {
          state.aiming = false;
          elCrosshair.classList.remove('aim');
        }
      });

      window.addEventListener('contextmenu', (e) => e.preventDefault());

      window.addEventListener('mousemove', (e) => {
        if (!state.active) return;
        if (state.pointerLocked) {
          state.camYaw -= e.movementX * 0.0028;
          state.camPitch = Math.max(-0.35, Math.min(0.85, state.camPitch + e.movementY * 0.0024));
        } else if (state.draggingLook) {
          const dx = e.clientX - state.lastMX;
          const dy = e.clientY - state.lastMY;
          state.lastMX = e.clientX;
          state.lastMY = e.clientY;
          state.camYaw -= dx * 0.0055;
          state.camPitch = Math.max(-0.35, Math.min(0.85, state.camPitch + dy * 0.0045));
        }
      });

      window.addEventListener('keydown', (e) => {
        const k = e.key.toLowerCase();
        state.keys[k] = true;
        if (e.code === 'Space') state.keys['space'] = true;
        if (!state.active) return;
        if (k === '1') selectWeapon(0);
        if (k === '2') selectWeapon(1);
        if (k === '3') selectWeapon(2);
        if (k === 'e' || k === 'у') toggleVehicle();
        if (k === 'f' || k === 'а') state.firing = true;
      });

      window.addEventListener('keyup', (e) => {
        const k = e.key.toLowerCase();
        state.keys[k] = false;
        if (e.code === 'Space') state.keys['space'] = false;
        if (k === 'f' || k === 'а') state.firing = false;
      });

      function collidesWithBuilding(x, z, r) {
        for (let i = 0; i < colliders.length; i++) {
          const c = colliders[i];
          if (x + r > c.minX && x - r < c.maxX && z + r > c.minZ && z - r < c.maxZ) return true;
        }
        return false;
      }

      // ============================================================
      // 13. LIVE GTA V RADAR MINIMAP RENDERER
      // ============================================================
      function drawMinimap() {
        const w = mapCanvas.width, h = mapCanvas.height;
        mapCtx.fillStyle = '#2d4736'; // hills background
        mapCtx.fillRect(0, 0, w, h);

        const scale = 0.65;
        const toMapX = (wx) => w * 0.5 + (wx - state.x) * scale;
        const toMapY = (wz) => h * 0.5 + (wz - state.z) * scale;

        // Ocean South
        const oceanY = toMapY(115);
        mapCtx.fillStyle = '#1b5e85';
        mapCtx.fillRect(0, oceanY, w, h - oceanY + 100);
        // Beach strip
        mapCtx.fillStyle = '#c9b079';
        mapCtx.fillRect(0, toMapY(94), w, (118 - 94) * scale);

        // City Roads
        mapCtx.fillStyle = '#47505c';
        [-54, 0, 54].forEach(rx => {
          mapCtx.fillRect(toMapX(rx - 6.5), toMapY(-92), 13 * scale, 184 * scale);
        });
        [-54, 0, 54].forEach(rz => {
          mapCtx.fillRect(toMapX(-92), toMapY(rz - 6.5), 184 * scale, 13 * scale);
        });

        // Cars (blue dots)
        cars.forEach(c => {
          mapCtx.fillStyle = c.isPolice ? '#60a5fa' : '#38bdf8';
          mapCtx.fillRect(toMapX(c.x) - 2.5, toMapY(c.z) - 2.5, 5, 5);
        });

        // Explosive barrels (orange)
        mapCtx.fillStyle = '#f97316';
        barrels.forEach(b => {
          if (b.alive) mapCtx.fillRect(toMapX(b.x) - 1.5, toMapY(b.z) - 1.5, 3, 3);
        });

        // Enemies (red circles)
        enemies.forEach(en => {
          if (en.hp <= 0) return;
          mapCtx.fillStyle = en.isPolice ? '#3b82f6' : '#ef4444';
          mapCtx.beginPath();
          mapCtx.arc(toMapX(en.x), toMapY(en.z), 3.2, 0, Math.PI * 2);
          mapCtx.fill();
        });

        // Player directional arrow at center
        mapCtx.save();
        mapCtx.translate(w * 0.5, h * 0.5);
        mapCtx.rotate(-state.camYaw);
        mapCtx.fillStyle = '#ffffff';
        mapCtx.beginPath();
        mapCtx.moveTo(0, -6);
        mapCtx.lineTo(4.5, 5);
        mapCtx.lineTo(0, 2.5);
        mapCtx.lineTo(-4.5, 5);
        mapCtx.closePath();
        mapCtx.fill();
        mapCtx.restore();
      }

      // ============================================================
      // 14. MAIN SIMULATION & RENDER LOOP
      // ============================================================
      const clock = new THREE.Clock();
      let dmgFlashAlpha = 0;

      function animate() {
        requestAnimationFrame(animate);
        const dt = Math.min(clock.getDelta(), 0.05);
        const t = clock.elapsedTime;
        oceanUniforms.uTime.value = t;

        // Fade muzzle flash & damage vignette
        muzzleFlash.intensity = Math.max(0, muzzleFlash.intensity - dt * 45);
        if (dmgFlashAlpha > 0) {
          dmgFlashAlpha = Math.max(0, dmgFlashAlpha - dt * 2.5);
          elDmgFlash.style.opacity = String(dmgFlashAlpha);
        }

        if (state.active && state.hp > 0) {
          // Arrow-key camera look support (handy if user doesn't use mouse!)
          if (state.keys['arrowleft'])  state.camYaw += 2.2 * dt;
          if (state.keys['arrowright']) state.camYaw -= 2.2 * dt;

          const fwdX = -Math.sin(state.camYaw);
          const fwdZ = -Math.cos(state.camYaw);
          const rightX = Math.cos(state.camYaw);
          const rightZ = -Math.sin(state.camYaw);

          const moveF = (state.keys['w'] || state.keys['ц'] || state.keys['arrowup'] ? 1 : 0) -
                        (state.keys['s'] || state.keys['ы'] || state.keys['arrowdown'] ? 1 : 0);
          const moveR = (state.keys['d'] || state.keys['в'] ? 1 : 0) -
                        (state.keys['a'] || state.keys['ф'] ? 1 : 0);

          if (state.inCar) {
            // --- DRIVING PHYSICS ---
            const car = state.inCar;
            const accel = moveF > 0 ? 34 : (moveF < 0 ? -28 : 0);
            if (accel !== 0) {
              car.speed = Math.max(-16, Math.min(46, car.speed + accel * dt));
            } else {
              car.speed *= Math.pow(0.18, dt);
            }
            if (Math.abs(car.speed) > 0.6) {
              const turnSign = car.speed >= 0 ? 1 : -1;
              car.yaw -= moveR * 2.2 * turnSign * Math.min(1, Math.abs(car.speed) / 10) * dt;
            }
            const nx = car.x - Math.sin(car.yaw) * car.speed * dt;
            const nz = car.z - Math.cos(car.yaw) * car.speed * dt;
            const limit = HALF_WORLD - 15;
            if (!collidesWithBuilding(nx, nz, 1.5) && Math.abs(nx) < limit && nz > -limit && nz < 135) {
              car.x = nx;
              car.z = nz;
            } else {
              car.speed *= -0.3;
              state.shake = Math.max(state.shake, 0.25);
            }
            car.y = getTerrainHeight(car.x, car.z);
            car.mesh.position.set(car.x, car.y, car.z);
            car.mesh.rotation.y = car.yaw;
            // Pitch car smoothly on Vinewood hills
            const hAhead = getTerrainHeight(car.x - Math.sin(car.yaw) * 2.0, car.z - Math.cos(car.yaw) * 2.0);
            car.mesh.rotation.x = Math.atan2(hAhead - car.y, 2.0);
            car.wheels.forEach(w => { w.rotation.x -= car.speed * dt * 2.4; });

            state.x = car.x;
            state.y = car.y;
            state.z = car.z;
            state.camYaw += (car.yaw - state.camYaw) * Math.min(1, dt * 1.4);
            elSpeed.textContent = `${Math.round(Math.abs(car.speed) * 3.6)} КМ/Ч`;
            elPrompt.classList.remove('visible');
          } else {
            // --- ON-FOOT THIRD-PERSON MOVEMENT ---
            const sprint = state.keys['shift'] && !state.aiming;
            const speed = state.aiming ? 4.2 : (sprint ? 12.5 : 7.2);

            let vx = (fwdX * moveF + rightX * moveR);
            let vz = (fwdZ * moveF + rightZ * moveR);
            const len = Math.hypot(vx, vz);
            if (len > 0.01) {
              vx = (vx / len) * speed;
              vz = (vz / len) * speed;
            }

            const nx = state.x + vx * dt;
            const nz = state.z + vz * dt;
            const limit = HALF_WORLD - 12;
            if (!collidesWithBuilding(nx, state.z, 0.55) && Math.abs(nx) < limit) state.x = nx;
            if (!collidesWithBuilding(state.x, nz, 0.55) && nz > -limit && nz < 134) state.z = nz;

            const groundY = Math.max(WATER_LEVEL + 0.1, getTerrainHeight(state.x, state.z));
            if (state.y <= groundY + 0.05 && state.keys['space']) {
              state.vy = 8.4;
            }
            state.vy -= 22.0 * dt;
            state.y += state.vy * dt;
            if (state.y < groundY) {
              state.y = groundY;
              state.vy = 0;
            }

            playerGroup.position.set(state.x, state.y, state.z);
            playerGroup.rotation.y = state.camYaw;

            // Smooth procedural walk/run limb animation
            const swing = len > 0.1 ? Math.sin(t * (sprint ? 14 : 9.5)) * (sprint ? 0.65 : 0.42) : 0;
            legL.rotation.x = swing;
            legR.rotation.x = -swing;
            armL.rotation.x = -swing * 0.7;

            // Shooting cooldown
            state.fireCd = Math.max(0, state.fireCd - dt);
            if (state.firing && state.fireCd <= 0) {
              fireWeapon();
            }

            // Show "Press E to enter car" prompt when near any car
            const nearCar = cars.some(c => Math.hypot(c.x - state.x, c.z - state.z) < 4.5);
            elPrompt.classList.toggle('visible', nearCar);
          }

          // --- AI ENEMIES & POLICE CHASE / SHOOT ---
          for (let i = 0; i < enemies.length; i++) {
            const en = enemies[i];
            if (en.hp <= 0) continue;
            const dx = state.x - en.x;
            const dz = state.z - en.z;
            const dist = Math.hypot(dx, dz);

            if (en.aggro || (en.isPolice && state.wanted > 0) || dist < 18) {
              const yaw = Math.atan2(-dx, -dz);
              en.mesh.rotation.y = yaw;
              if (dist > 14 && dist < 95) {
                const spd = en.isPolice ? 6.4 : 4.8;
                en.x += (dx / dist) * spd * dt;
                en.z += (dz / dist) * spd * dt;
                en.y = getTerrainHeight(en.x, en.z);
                en.mesh.position.set(en.x, en.y, en.z);
                const sw = Math.sin(t * 9 + i) * 0.45;
                en.l1.rotation.x = sw;
                en.l2.rotation.x = -sw;
              }
              en.shootCd -= dt;
              if (en.shootCd <= 0 && dist < 55) {
                en.shootCd = en.isPolice ? 1.05 : 1.45;
                const pStart = new THREE.Vector3(en.x, en.y + 1.45, en.z);
                const pEnd = new THREE.Vector3(state.x + (Math.random() - 0.5) * 1.4, state.y + 1.15, state.z + (Math.random() - 0.5) * 1.4);
                spawnTracer(pStart, pEnd, 0xff4444);
                if (Math.random() < (state.inCar ? 0.2 : 0.42)) {
                  const dmg = en.isPolice ? 9 : 6;
                  if (state.armor > 0) state.armor = Math.max(0, state.armor - dmg);
                  else state.hp = Math.max(0, state.hp - dmg);
                  dmgFlashAlpha = 0.7;
                  updateHudStats();
                  if (state.hp <= 0) {
                    state.active = false;
                    elOvTitle.textContent = 'ПОТРАЧЕНО';
                    elOvTitle.style.color = '#ff4757';
                    elOvDesc.textContent = `Вас нейтрализовали в районе ${getZoneName(state.x, state.z)}. Счёт: $${state.cash.toLocaleString('ru-RU')}.`;
                    btnStart.textContent = 'ВОЗРОДИТЬСЯ';
                    elOverlay.classList.remove('hidden');
                    if (document.exitPointerLock) try { document.exitPointerLock(); } catch (e) {}
                  }
                }
              }
            }
          }

          elZone.textContent = getZoneName(state.x, state.z);
        }

        // Update Tracers & Explosions
        for (let i = tracers.length - 1; i >= 0; i--) {
          tracers[i].life -= dt;
          if (tracers[i].life <= 0) {
            scene.remove(tracers[i].line);
            tracers.splice(i, 1);
          }
        }

        for (let i = explosions.length - 1; i >= 0; i--) {
          const ex = explosions[i];
          ex.life -= dt;
          const frac = Math.max(0, ex.life / ex.maxLife);
          ex.light.intensity = frac * 8;
          ex.parts.forEach(p => {
            p.vel.y -= 14 * dt;
            p.m.position.addScaledVector(p.vel, dt);
            p.m.scale.setScalar(1.0 + (1 - frac) * 1.6);
            p.m.material.opacity = frac;
          });
          if (ex.life <= 0) {
            scene.remove(ex.group);
            explosions.splice(i, 1);
          }
        }

        // --- THIRD-PERSON GTA CAMERA ---
        state.shake = Math.max(0, state.shake - dt * 2.0);
        const shX = (Math.random() - 0.5) * state.shake;
        const shY = (Math.random() - 0.5) * state.shake;

        const targetFov = state.aiming ? 40 : (state.inCar ? 66 : 58);
        camera.fov += (targetFov - camera.fov) * Math.min(1, dt * 8);
        camera.updateProjectionMatrix();

        const camDist = state.inCar ? 7.8 : (state.aiming ? 2.4 : 4.6);
        const shoulderOffset = state.inCar ? 0 : (state.aiming ? 0.72 : 0.65);
        const pivotY = state.y + (state.inCar ? 2.1 : 1.75);

        const sinY = Math.sin(state.camYaw), cosY = Math.cos(state.camYaw);
        const cx = state.x + sinY * camDist * Math.cos(state.camPitch) + cosY * shoulderOffset + shX;
        const cz = state.z + cosY * camDist * Math.cos(state.camPitch) - sinY * shoulderOffset;
        const cy = Math.max(getTerrainHeight(cx, cz) + 0.65, pivotY + Math.sin(state.camPitch) * camDist + shY);

        camera.position.set(cx, cy, cz);
        camera.lookAt(
          state.x - sinY * 18 + cosY * shoulderOffset,
          pivotY - Math.sin(state.camPitch) * 14,
          state.z - cosY * 18 - sinY * shoulderOffset
        );

        drawMinimap();
        renderer.render(scene, camera);
      }

      window.addEventListener('resize', () => {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
      });

      animate();
    })();
  </script>
</body>
